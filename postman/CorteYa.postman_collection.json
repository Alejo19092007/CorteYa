            "description": "Requiere haber cargado los datos de demo (php artisan demo:cargar) o tener al menos un barbero activo con horario."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const barberos = pm.response.json().data;",
                  "pm.test(\"Hay al menos un barbero activo\", () => pm.expect(barberos.length).to.be.above(0));",
                  "pm.collectionVariables.set(\"barbero_id\", barberos[0].id);"
                ]
              }
            }
          ]
        },
