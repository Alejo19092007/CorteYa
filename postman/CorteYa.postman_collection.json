            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"{{telefono}}\",\n  \"nombre\": \"Cliente de Postman\",\n  \"barbero_id\": {{barbero_id}},\n  \"fecha\": \"{{fecha}}\",\n  \"hora_inicio\": \"{{hora}}\",\n  \"servicios\": [\n    {{servicio_id}}\n  ]\n}",
