{
  "info": {
    "name": "CorteYa API",
    "description": "API REST de CorteYa (Laravel 12 + Sanctum). Ejecutar la colección completa (Runner) en orden: el login guarda el token y cada petición verifica su código de respuesta.\n\nRequisito: base con los datos de demo (php artisan demo:cargar) o al menos un barbero activo con horario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de mañana (Y-m-d), para que el turno sea futuro y cancelable (R3)",
          "const manana = new Date(Date.now() + 24 * 60 * 60 * 1000);",
          "const dos = (n) => String(n).padStart(2, \"0\");",
          "pm.collectionVariables.set(\"fecha\", `${manana.getFullYear()}-${dos(manana.getMonth() + 1)}-${dos(manana.getDate())}`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "fecha",
      "value": ""
    },
    {
      "key": "hora",
      "value": "10:00"
    },
    {
      "key": "telefono",
      "value": "573009990000"
    },
    {
      "key": "servicio_id",
      "value": "1"
    },
    {
      "key": "barbero_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "POST /login (200) — guarda el token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Inicia sesión y guarda el token Sanctum en la variable {{token}}; el resto de peticiones lo usan solas.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve un token Bearer\", () => { pm.expect(datos.token).to.be.a(\"string\").and.not.empty; pm.expect(datos.token_type).to.eql(\"Bearer\"); });",
                  "pm.test(\"No expone la contraseña\", () => pm.expect(datos.user).to.not.have.property(\"password\"));",
                  "pm.collectionVariables.set(\"token\", datos.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /login con contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"contraseña-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensaje: Credenciales incorrectas\", () => pm.expect(pm.response.json().message).to.include(\"Credenciales incorrectas\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /login sin datos (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Indica los campos con error\", () => pm.expect(pm.response.json().errors).to.have.keys(\"email\", \"password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /servicios sin token (401)",
