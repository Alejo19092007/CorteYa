# ---- API de CorteYa -------------------------------------------------------
# URL pública con https:// (nunca localhost; solo con MODO_SIMULADOR=true se permite el backend local)
CORTEYA_API_URL=https://corteya.onrender.com
# Cuenta de servicio del bot (la crea el backend si defines SEED_BOT_PASSWORD). No uses la cuenta del dueño
BOT_EMAIL=bot@corteya.com
BOT_PASSWORD=

# ---- Canal ----------------------------------------------------------------
# telegram (por defecto) o whatsapp
CANAL=telegram

# ---- Telegram -------------------------------------------------------------
# Token que entrega @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=
# polling: el bot pregunta a Telegram (para probar en tu computador, sin URL pública)
# webhook: Telegram avisa por HTTPS (para el servidor; es lo que usa NODE_ENV=production)
TELEGRAM_MODO=polling
# Solo modo webhook: secreto inventado por ti (16-256 caracteres: letras, números, - o _)
#TELEGRAM_WEBHOOK_SECRET=
# Solo modo webhook: URL pública del bot. En Render se toma sola de RENDER_EXTERNAL_URL
#BOT_PUBLIC_URL=

# ---- WhatsApp (solo si CANAL=whatsapp) ------------------------------------
#WHATSAPP_TOKEN=
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_VERIFY_TOKEN=
#WHATSAPP_APP_SECRET=
#WHATSAPP_GRAPH_VERSION=v22.0

# ---- Pruebas sin Telegram ni WhatsApp --------------------------------------
# true abre un chat de prueba en http://localhost:3000/simulador (no se permite con NODE_ENV=production)
#MODO_SIMULADOR=true
#PORT=3000
